erDiagram
    %% ============================================================
    %% CRM - Modelo Entidad-Relación simplificado
    %% Alcance de la entrega inicial (20 de octubre):
    %% clientes, interacciones y pipeline de oportunidades.
    %% Entidades: Cliente, Empleado, Oportunidad, Interacción.
    %% El diccionario de datos está en docs/crm_simple_diccionario.md
    %% ============================================================

    CLIENTE {
        int id_cliente PK
        varchar nombre_empresa
        varchar persona_contacto
        varchar correo
        varchar telefono
        varchar estado_cliente
    }

    EMPLEADO {
        int id_empleado PK
        varchar nombre
        varchar cargo
    }

    OPORTUNIDAD {
        int id_oportunidad PK
        int id_cliente FK
        int id_empleado FK
        varchar descripcion
        decimal monto_estimado
        varchar etapa
        date fecha_estimada_cierre
    }

    INTERACCION {
        int id_interaccion PK
        int id_cliente FK
        int id_empleado FK
        date fecha
        varchar tipo_interaccion
        varchar descripcion
    }

    CLIENTE ||--o{ OPORTUNIDAD : "genera"
    EMPLEADO ||--o{ OPORTUNIDAD : "gestiona"
    CLIENTE ||--o{ INTERACCION : "registra"
    EMPLEADO ||--o{ INTERACCION : "realiza"
